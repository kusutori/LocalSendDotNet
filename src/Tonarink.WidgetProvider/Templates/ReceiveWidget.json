{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "ms-appx:///Assets/StoreLogo.png",
              "size": "small",
              "altText": "Tonarink"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "bolder",
              "size": "medium",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "${alias}",
              "isSubtle": true,
              "spacing": "none",
              "wrap": true
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${address}",
      "wrap": true,
      "spacing": "small",
      "$when": "${$host.widgetSize==\"medium\"}"
    },
    {
      "type": "TextBlock",
      "text": "${address}",
      "wrap": true,
      "spacing": "small",
      "$when": "${$host.widgetSize==\"large\"}"
    },
    {
      "type": "TextBlock",
      "text": "${status}",
      "isSubtle": true,
      "wrap": true,
      "spacing": "small",
      "$when": "${$host.widgetSize==\"large\"}"
    }
  ],
  "selectAction": {
    "type": "Action.Execute",
    "verb": "open"
  },
  "actions": [
    {
      "type": "Action.Execute",
      "title": "${openLabel}",
      "verb": "open",
      "$when": "${$host.widgetSize==\"large\"}"
    }
  ]
}
