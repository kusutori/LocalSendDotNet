{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "Image",
              "url": "${statusIcon}",
              "size": "small",
              "width": "18px",
              "altText": "${appStatusLabel}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "bolder",
              "size": "medium",
              "spacing": "none"
            },
            {
              "type": "TextBlock",
              "text": "${appStatusLabel}",
              "isSubtle": true,
              "spacing": "none",
              "size": "small"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "center",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "toggle"
          },
          "items": [
            {
              "type": "Container",
              "style": "emphasis",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${serverLabel} ${serverValue}",
                  "weight": "bolder",
                  "size": "small"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${serverHint}",
      "isSubtle": true,
      "wrap": true,
      "size": "small",
      "spacing": "small",
      "$when": "${$host.widgetSize != \"small\"}"
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "medium",
      "$when": "${hasTransfer}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${transferTitle}",
          "weight": "bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${transferPeer}",
          "isSubtle": true,
          "spacing": "none",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${transferStatus}",
          "spacing": "small",
          "wrap": true,
          "size": "small"
        },
        {
          "type": "ColumnSet",
          "spacing": "small",
          "$when": "${hasProgressBar}",
          "columns": [
            {
              "type": "Column",
              "width": "${progressFilled}",
              "items": [
                {
                  "type": "Container",
                  "style": "accent",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": " ",
                      "size": "small"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Column",
              "width": "${progressRest}",
              "items": [
                {
                  "type": "Container",
                  "style": "emphasis",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": " ",
                      "size": "small"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${transferProgress}",
          "isSubtle": true,
          "spacing": "small",
          "size": "small",
          "$when": "${hasProgressBar}"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "medium",
      "$when": "${$host.widgetSize == \"small\" && isNearby && !hasTransfer}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${deviceCountLabel}",
          "weight": "bolder",
          "horizontalAlignment": "center"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "medium",
      "$when": "${$host.widgetSize == \"small\" && isHistory && !hasTransfer}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${historyCountLabel}",
          "weight": "bolder",
          "horizontalAlignment": "center"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "medium",
      "$when": "${$host.widgetSize != \"small\" && isNearby && !hasTransfer && hasDevices}",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${devices}",
          "$when": "${($host.widgetSize == \"medium\" && $index < 3) || ($host.widgetSize == \"large\" && $index < 8)}",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "Image",
                  "url": "${icon}",
                  "size": "small",
                  "width": "24px",
                  "altText": "${alias}"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${alias}",
                  "wrap": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${emptyLabel}",
      "isSubtle": true,
      "spacing": "medium",
      "horizontalAlignment": "center",
      "$when": "${$host.widgetSize != \"small\" && isNearby && !hasTransfer && !hasDevices}"
    },
    {
      "type": "Container",
      "spacing": "medium",
      "$when": "${$host.widgetSize != \"small\" && isHistory && !hasTransfer && hasHistoryItems}",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${history}",
          "$when": "${($host.widgetSize == \"medium\" && $index < 4) || ($host.widgetSize == \"large\" && $index < 8)}",
          "spacing": "small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${fileName}",
                  "weight": "bolder",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${detail}",
                  "isSubtle": true,
                  "spacing": "none",
                  "size": "small",
                  "wrap": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${historyEmptyLabel}",
      "isSubtle": true,
      "spacing": "medium",
      "horizontalAlignment": "center",
      "$when": "${$host.widgetSize != \"small\" && isHistory && !hasTransfer && !hasHistoryItems}"
    },
    {
      "type": "ColumnSet",
      "spacing": "medium",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "nearby"
          },
          "items": [
            {
              "type": "TextBlock",
              "text": "${nearbyTab}",
              "weight": "${nearbyWeight}",
              "horizontalAlignment": "center"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "history"
          },
          "items": [
            {
              "type": "TextBlock",
              "text": "${historyTab}",
              "weight": "${historyWeight}",
              "horizontalAlignment": "center"
            }
          ]
        }
      ]
    }
  ],
  "selectAction": {
    "type": "Action.Execute",
    "verb": "open"
  },
  "actions": [
    {
      "type": "Action.Execute",
      "title": "${openLabel}",
      "verb": "open",
      "$when": "${$host.widgetSize == \"large\" && !appRunning}"
    }
  ]
}
